@using System.ComponentModel
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@attribute [EditorBrowsable(EditorBrowsableState.Never)]

<div class="minq-settings-panel">
    @if (Parent.IsViewingSharedState)
    {
        <div class="minq-shared-alert">
            <span><strong>Shared View Active:</strong> Your local preferences are currently paused to display this URL.</span>
            <button class="minq-button minq-button-primary" style="margin: 0;" @onclick="Parent.SaveSharedAsDefault">Save as My Default</button>
        </div>
    }

    <MinqViewerSettingsGroup Title="Data">
        <MinqSlider Title="Page Size" Options="Parent.PageSizeOptions" @bind-Value="Parent.PageSize" OnChange="Parent.OnPageSizeChanged" Unit="records" />
        <div style="margin-top: 0.75rem;">
            <MinqSlider Title="Refresh Rate" Options="Parent.RefreshOptions" @bind-Value="Parent.RefreshInterval" OnChange="Parent.OnRefreshIntervalChanged" Unit="s" />
        </div>
    </MinqViewerSettingsGroup>

    <MinqViewerSettingsGroup Title="Appearance">
        <div style="display: flex; flex-direction: column; gap: 0.35rem;">
            <label style="font-size: 0.85rem; color: var(--minq-text-main); font-weight: 600;">Theme</label>
            <select class="minq-input" style="cursor: pointer;" value="@Parent.SelectedThemeName" @onchange="HandleThemeChange">
                @foreach (var theme in Parent.AvailableThemes)
                {
                    <option value="@theme.Name">@theme.Name</option>
                }
            </select>
        </div>
        
        <div style="margin-top: 1rem;">
            <MinqSlider Title="Font Size" Options="Parent.FontSizeOptions" @bind-Value="Parent.TableFontSize" OnChange="Parent.SavePreferencesAsync" Unit="px" />
        </div>
    </MinqViewerSettingsGroup>

    <MinqViewerSettingsGroup Title="Columns">
        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
            <MinqSlider Title="Pinned Column Width" Options="Parent.PinnedWidthOptions" @bind-Value="Parent.PinnedColumnWidth" OnChange="Parent.SavePreferencesAsync" Unit="px" />
            
            <div style="margin-top: 0.5rem;">
                <MinqSlider Title="Unpinned Column Width" Options="Parent.MaxWidthOptions" @bind-Value="Parent.MaxColumnWidth" OnChange="Parent.SavePreferencesAsync" Unit="px" />
            </div>
            
            <button class="minq-button" style="margin-top: 1rem;" @onclick="Parent.OpenColumnPicker">Choose Columns</button>
        </div>
    </MinqViewerSettingsGroup>

    <MinqViewerSettingsGroup Title="Table Options">
        <div style="display: flex; flex-direction: column; gap: 0.6rem; margin-top: 0.25rem;">
            <label class="minq-toggle-label">
                <div class="minq-switch">
                    <input type="checkbox" @bind="Parent.FlattenJsonProperties" @bind:after="Parent.OnViewDataChanged" />
                    <span class="minq-slider-round"></span>
                </div>
                Flatten Nested Objects
            </label>
            <label class="minq-toggle-label">
                <div class="minq-switch">
                    <input type="checkbox" @bind="Parent.HideDefaultValues" @bind:after="Parent.OnViewDataChanged" />
                    <span class="minq-slider-round"></span>
                </div>
                Hide Default Values
            </label>
        </div>

        <MinqRadio Title="Timestamp Format" 
                   Name="timestampFormat"
                   Options="TimestampOptions" 
                   @bind-Value="Parent.TimestampFormat" 
                   OnChange="Parent.SavePreferencesAsync" />
                   
        <MinqRadio Title="On Click" 
                   Name="rowClickBehavior"
                   Options="ClickOptions" 
                   @bind-Value="Parent.RowClickBehavior" 
                   OnChange="Parent.SavePreferencesAsync" />
    </MinqViewerSettingsGroup>

    <MinqViewerSettingsGroup Title="Danger Zone">
        <div style="margin-top: 0.5rem;">
            <button class="minq-button minq-button-danger" disabled="@(!Parent.CanDeleteCollection)" @onclick="Parent.OpenDeleteAllModal">Delete All Records</button>
        </div>
    </MinqViewerSettingsGroup>
</div>

@code {
    [CascadingParameter]
    public MinqViewer Parent { get; set; }

    // Add this explicit handler!
    private async Task HandleThemeChange(ChangeEventArgs e)
    {
        Parent.SelectedThemeName = e.Value?.ToString() ?? "Light Mode";
        await Parent.OnThemeChangedAsync();
    }

    private List<MinqViewer.MinqRadioOption<MinqViewer.TimestampFormatOption>> TimestampOptions => new()
    {
        new() { Value = MinqViewer.TimestampFormatOption.Local, Label = "DateTime (Local)" },
        new() { Value = MinqViewer.TimestampFormatOption.Utc, Label = "DateTime (UTC)" },
        new() { Value = MinqViewer.TimestampFormatOption.Unix, Label = "Unix Timestamp (UTC)" },
        new() { Value = MinqViewer.TimestampFormatOption.Elapsed, Label = "Elapsed Time" }
    };

    private List<MinqViewer.MinqRadioOption<MinqViewer.RowClickBehaviorOption>> ClickOptions => new()
    {
        new() { Value = MinqViewer.RowClickBehaviorOption.SelectText, Label = "Select Text" },
        new() { Value = MinqViewer.RowClickBehaviorOption.EditRecord, Label = "Edit Record" },
        new() { Value = MinqViewer.RowClickBehaviorOption.DeleteRecord, Label = "Delete Record", IsDisabled = !Parent.CanDeleteSingle }
    };
}