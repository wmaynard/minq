@using System.ComponentModel
@using Maynard.Minq.Blazor.Enums
@using Maynard.Minq.Blazor.Models
@using Microsoft.AspNetCore.Components.Web

@attribute [EditorBrowsable(EditorBrowsableState.Never)]

<div class="minq-settings-panel">
    @if (IsViewingSharedState)
    {
        <div class="minq-shared-alert">
            <span><strong>Shared View Active:</strong> Your local preferences are currently paused to display this URL.</span>
            <button class="minq-button minq-button-primary" style="margin: 0;" @onclick="OnSaveSharedAsDefault">Save as My Default</button>
        </div>
    }

    <MinqViewerSettingsGroup Title="Data">
        <MinqSlider Title="Page Size" Options="PageSizeOptions" @bind-Value="Settings.PageSize" OnChange="OnPageSizeChanged" Unit="records" />
        <div style="margin-top: 0.75rem;">
            <MinqSlider Title="Refresh Rate" Options="RefreshOptions" @bind-Value="Settings.RefreshInterval" OnChange="OnRefreshIntervalChanged" Unit="s" />
        </div>
    </MinqViewerSettingsGroup>

    <MinqViewerSettingsGroup Title="Appearance">
        <div style="display: flex; flex-direction: column; gap: 0.35rem;">
            <label style="font-size: 0.85rem; color: var(--minq-text-main); font-weight: 600;">Theme</label>
            <select class="minq-input" style="cursor: pointer;" value="@Settings.SelectedThemeName" @onchange="HandleThemeChange">
                @foreach (var theme in AvailableThemes)
                {
                    <option value="@theme">@theme</option>
                }
            </select>
        </div>
        
        <div style="margin-top: 1rem;">
            <MinqSlider Title="Font Size" Options="FontSizeOptions" @bind-Value="Settings.TableFontSize" OnChange="OnPreferencesChanged" Unit="px" />
        </div>
    </MinqViewerSettingsGroup>

    <MinqViewerSettingsGroup Title="Columns">
        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
            <MinqSlider Title="Pinned Column Width" Options="PinnedWidthOptions" @bind-Value="Settings.PinnedColumnWidth" OnChange="OnPreferencesChanged" Unit="px" />
            
            <div style="margin-top: 0.5rem;">
                <MinqSlider Title="Unpinned Column Width" Options="MaxWidthOptions" @bind-Value="Settings.MaxColumnWidth" OnChange="OnPreferencesChanged" Unit="px" />
            </div>
            
            <button class="minq-button" style="margin-top: 1rem;" @onclick="OnOpenColumnPicker">Choose Columns</button>
        </div>
    </MinqViewerSettingsGroup>

    <MinqViewerSettingsGroup Title="Table Options">
        <div style="display: flex; flex-direction: column; gap: 0.6rem; margin-top: 0.25rem;">
            <label class="minq-toggle-label">
                <div class="minq-switch">
                    <input type="checkbox" @bind="Settings.FlattenJsonProperties" @bind:after="InvokeOnViewDataChanged" />
                    <span class="minq-slider-round"></span>
                </div>
                Flatten Nested Objects
            </label>
            <label class="minq-toggle-label">
                <div class="minq-switch">
                    <input type="checkbox" @bind="Settings.HideDefaultValues" @bind:after="InvokeOnViewDataChanged" />
                    <span class="minq-slider-round"></span>
                </div>
                Hide Default Values
            </label>
        </div>

        <MinqRadio Title="Timestamp Format" 
                   Name="timestampFormat"
                   Options="TimestampOptions" 
                   @bind-Value="Settings.TimestampFormat" 
                   OnChange="OnPreferencesChanged" />
                   
        <MinqRadio Title="On Click" 
                   Name="rowClickBehavior"
                   Options="ClickOptions" 
                   @bind-Value="Settings.RowClickBehavior" 
                   OnChange="OnPreferencesChanged" />
    </MinqViewerSettingsGroup>

    <MinqViewerSettingsGroup Title="Danger Zone">
        <div style="margin-top: 0.5rem;">
            <button class="minq-button minq-button-danger" disabled="@(!CanDeleteCollection)" @onclick="OnOpenDeleteAllModal">Delete All Records</button>
        </div>
    </MinqViewerSettingsGroup>
</div>

@code {
    [Parameter, EditorRequired]
    public MinqViewerState Settings { get; set; } = default!;

    [Parameter] public IEnumerable<string> AvailableThemes { get; set; } = Array.Empty<string>();
    [Parameter] public bool IsViewingSharedState { get; set; }
    [Parameter] public bool CanDeleteSingle { get; set; }
    [Parameter] public bool CanDeleteCollection { get; set; }

    [Parameter] public EventCallback OnSaveSharedAsDefault { get; set; }
    [Parameter] public EventCallback OnPageSizeChanged { get; set; }
    [Parameter] public EventCallback OnRefreshIntervalChanged { get; set; }
    [Parameter] public EventCallback OnThemeChanged { get; set; }
    [Parameter] public EventCallback OnPreferencesChanged { get; set; }
    [Parameter] public EventCallback OnViewDataChanged { get; set; }
    [Parameter] public EventCallback OnOpenColumnPicker { get; set; }
    [Parameter] public EventCallback OnOpenDeleteAllModal { get; set; }
    
    private static readonly int[] PageSizeOptions = [10, 25, 50, 75, 100];
    private static readonly int[] RefreshOptions = Enumerable.Range(0, 31).Select(x => x * 10).ToArray();
    private static readonly int[] FontSizeOptions = Enumerable.Range(6, 21).ToArray();
    private static readonly int[] PinnedWidthOptions = Enumerable.Range(2, 9).Select(x => x * 50).ToArray();
    private static readonly int[] MaxWidthOptions = Enumerable.Range(2, 23).Select(x => x * 50).ToArray();

    private async Task HandleThemeChange(ChangeEventArgs e)
    {
        Settings.SelectedThemeName = e.Value?.ToString() ?? "Light Mode";
        await OnThemeChanged.InvokeAsync();
    }

    // This wrapper is STRICTLY for the native HTML checkboxes
    private Task InvokeOnViewDataChanged() => OnViewDataChanged.InvokeAsync();

    private List<MinqRadioOption<TimestampFormatOption>> TimestampOptions => new()
    {
        new() { Value = TimestampFormatOption.Local, Label = "DateTime (Local)" },
        new() { Value = TimestampFormatOption.Utc, Label = "DateTime (UTC)" },
        new() { Value = TimestampFormatOption.Unix, Label = "Unix Timestamp (UTC)" },
        new() { Value = TimestampFormatOption.Elapsed, Label = "Elapsed Time" }
    };

    private List<MinqRadioOption<RowClickBehaviorOption>> ClickOptions => new()
    {
        new() { Value = RowClickBehaviorOption.SelectText, Label = "Select Text" },
        new() { Value = RowClickBehaviorOption.EditRecord, Label = "Edit Record" },
        new() { Value = RowClickBehaviorOption.DeleteRecord, Label = "Delete Record", IsDisabled = !CanDeleteSingle }
    };
}