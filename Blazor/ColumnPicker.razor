@using System.ComponentModel
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@attribute [EditorBrowsable(EditorBrowsableState.Never)]

<div class="minq-modal-backdrop" @onclick="Cancel">
    <div class="minq-modal-surface" @onclick:stopPropagation="true">
        
        <div class="minq-modal-header">
            <h3>Choose Columns</h3>
        </div>
        
        <div class="minq-modal-body">
            @foreach(string col in AvailableColumns)
            {
                bool isHidden = LocalHiddenColumns.Contains(col);
                <label class="minq-column-option @(isHidden ? "dimmed" : "")">
                    <div class="minq-switch">
                        <input type="checkbox" checked="@(!isHidden)" @onchange="@((ChangeEventArgs e) => ToggleColumn(col, e))" />
                        <span class="minq-slider-round"></span>
                    </div>
                    @col
                </label>
            }
        </div>
        
        <div class="minq-modal-footer">
            <button class="minq-button" @onclick="Cancel">Cancel</button>
            <button class="minq-button minq-button-primary" @onclick="Apply">Apply</button>
        </div>
        
    </div>
</div>

@code {
    [Parameter] 
    public List<string> AvailableColumns { get; set; } = [];
    
    [Parameter] 
    public HashSet<string> HiddenColumns { get; set; } = [];
    
    [Parameter] 
    public EventCallback<HashSet<string>> OnApply { get; set; }
    
    [Parameter] 
    public EventCallback OnCancel { get; set; }

    public HashSet<string> LocalHiddenColumns { get; set; } = [];

    protected override void OnInitialized()
    {
        LocalHiddenColumns = new HashSet<string>(HiddenColumns);
    }

    public void ToggleColumn(string col, ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out bool isChecked))
        {
            if (isChecked)
                LocalHiddenColumns.Remove(col);
            else
                LocalHiddenColumns.Add(col);
        }
    }

    public async Task Apply()
    {
        await OnApply.InvokeAsync(LocalHiddenColumns);
    }

    public async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}