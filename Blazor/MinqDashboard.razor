@using Maynard.Json
@using Maynard.Json.Attributes
@using Maynard.Json.Enums
@using Maynard.Minq.Blazor.Models
@using Maynard.Minq.Blazor.Themes
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web;
@inject IJSRuntime JSRuntime

<CascadingValue Value="this" IsFixed="true">
    <div class="minq-container minq-tab-group-container" style="@ThemeVariables">
        
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <h2 class="minq-tab-group-title">@Title</h2>
        }
        
        <div class="minq-tabs-header">
            @foreach (MinqViewer viewer in Viewers)
            {
                <button class="minq-tab-button @(ActiveViewer == viewer ? "active" : "")"
                        @onclick="() => ActivateTab(viewer)">
                    @viewer.DisplayTitle
                </button>
            }
        </div>
        
        <div class="minq-tabs-content">
            @ChildContent
        </div>
        
    </div>
</CascadingValue>

@code {
    [Parameter] 
    public string Title { get; set; }
    
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    public List<MinqViewer> Viewers { get; set; } = new();
    public MinqViewer ActiveViewer { get; set; }

    public string SelectedThemeName { get; set; } = "Light Mode";
    
    private string ThemeVariables => (ThemeManager
        .GetAvailableThemes()
        .FirstOrDefault(t => t.Name == SelectedThemeName)
        ?? new DarkThemeProvider()
    )
    .ToString();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            string globalJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "MinqViewer_Global");
            if (string.IsNullOrWhiteSpace(globalJson))
                return;
            TabSettingsPayload tabSettings = FlexModel.FromJSON<TabSettingsPayload>(globalJson);
            if (string.IsNullOrWhiteSpace(tabSettings?.ThemeName))
                return;
            
            SelectedThemeName = tabSettings.ThemeName;
            StateHasChanged();
        }
        catch { }
    }

    public void AddViewer(MinqViewer viewer)
    {
        if (Viewers.Contains(viewer))
            return;
        
        Viewers.Add(viewer);
        ActiveViewer ??= viewer; 
                
        StateHasChanged();
    }

    public void ActivateTab(MinqViewer viewer)
    {
        ActiveViewer = viewer;
        StateHasChanged();
    }
    

    internal void NotifyThemeChanged(string newThemeName)
    {
        if (SelectedThemeName == newThemeName)
            return;
        SelectedThemeName = newThemeName;
        
        // Sync all sibling tabs so they don't render with a stale theme when clicked
        foreach (MinqViewer viewer in Viewers)
            if (viewer.State.SelectedThemeName != newThemeName)
                viewer.State.SelectedThemeName = newThemeName;
        
        StateHasChanged();
    }
}