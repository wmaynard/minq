@implements IDisposable
@using System.ComponentModel
@using System.Threading
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@attribute [EditorBrowsable(EditorBrowsableState.Never)]

<div class="@CssClass" 
     title="@TooltipText" 
     @onclick="TogglePause">
    
    @(IsPaused ? "Paused" : "Auto-refresh")
    
    <div class="minq-refresh-ring">
        <svg width="36" height="36">
            <circle cx="18" cy="18" r="14" fill="none" stroke="var(--minq-border)" stroke-width="4" />
            @if (Interval > 0 && !IsPaused)
            {
                <circle cx="18" cy="18" r="14" fill="none" stroke="var(--minq-primary)" stroke-width="4" 
                        stroke-dasharray="87.96" 
                        stroke-dashoffset="@RefreshDashOffset.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" 
                        stroke-linecap="round" />
            }
            else if (IsPaused && Interval > 0)
            {
                <circle cx="18" cy="18" r="14" fill="none" stroke="var(--minq-text-disabled)" stroke-width="4" 
                        stroke-dasharray="87.96" 
                        stroke-dashoffset="0" 
                        stroke-linecap="round" />
            }
        </svg>
        <div class="minq-refresh-value">
            @if (Interval <= 0)
            {
                <span style="font-size: 1.2rem; line-height: 0;">-</span>
            }
            else if (IsPaused)
            {
                <span style="letter-spacing: 1px; font-size: 0.75rem;">||</span>
            }
            else
            {
                @SecondsRemaining
            }
        </div>
    </div>
</div>

@code {
    [Parameter] 
    public int Interval { get; set; }
    
    [Parameter] 
    public EventCallback OnRefreshTriggered { get; set; }

    public int SecondsRemaining { get; set; }
    public int LastInterval { get; set; }
    public bool IsPaused { get; set; } = false;
    
    public double RefreshDashOffset => Interval > 0 ? (1.0 - ((double)SecondsRemaining / Interval)) * 87.964 : 87.964;

    public string TooltipText => Interval <= 0 ? "Refresh Disabled" : (IsPaused ? "Click to Resume" : "Click to Pause");
    
    public string CssClass => $"minq-refresh-container {(Interval <= 0 ? "minq-timer-disabled" : "")}";

    public PeriodicTimer Timer { get; set; }
    public CancellationTokenSource Cts { get; set; } = new CancellationTokenSource();

    protected override void OnInitialized()
    {
        LastInterval = Interval;
        SecondsRemaining = Interval;
        Timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunTimerAsync();
    }

    protected override void OnParametersSet()
    {
        if (Interval != LastInterval)
        {
            LastInterval = Interval;
            SecondsRemaining = Interval;
            
            if (Interval <= 0)
                IsPaused = false;
        }
    }

    public async Task TogglePause()
    {
        if (Interval > 0)
        {
            IsPaused = !IsPaused;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void ResetTimer()
    {
        SecondsRemaining = Interval;
        InvokeAsync(StateHasChanged);
    }

    public async Task RunTimerAsync()
    {
        try
        {
            while (await Timer.WaitForNextTickAsync(Cts.Token))
            {
                if (Interval > 0 && !IsPaused)
                {
                    SecondsRemaining--;
                    
                    if (SecondsRemaining <= 0)
                    {
                        SecondsRemaining = Interval;
                        await OnRefreshTriggered.InvokeAsync();
                    }
                    else
                        await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        Cts.Cancel();
        Cts.Dispose();
        Timer?.Dispose();
    }
}