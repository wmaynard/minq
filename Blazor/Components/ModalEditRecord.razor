@using System.ComponentModel
@using System.Reflection
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Maynard.Logging
@using System.Linq
@using Maynard.Minq.Blazor.Helpers
@using Maynard.Minq.Blazor.Models
@inject IJSRuntime JSRuntime

@attribute [EditorBrowsable(EditorBrowsableState.Never)]

<div class="minq-modal-backdrop" tabindex="-1" @ref="ModalRef" @onkeydown="HandleKeyDown" @onclick="Cancel">
    <div class="minq-modal-surface" @onclick:stopPropagation="true">
        
        <div class="minq-modal-header">
            <h3>Edit Record</h3>
            <span class="minq-keys-legend">(json / bson)</span>
        </div>
        
        <div class="minq-modal-body">
            @foreach(FieldState field in FieldStates)
            {
                <div class="minq-form-group">
                    <div class="minq-field-header">
                        <label>@field.Definition.Name</label>
                        <span class="minq-field-keys">
                            (<span class="@(field.Definition.IsJsonIgnored ? "minq-text-danger" : "")">@(field.Definition.IsJsonIgnored ? "ignored" : (field.Definition.JsonName ?? field.Definition.PropertyName))</span> / 
                             <span class="@(field.Definition.IsBsonIgnored ? "minq-text-danger" : "")">@(field.Definition.IsBsonIgnored ? "ignored" : (field.Definition.BsonName ?? field.Definition.PropertyName))</span>)
                        </span>
                    </div>

                    @if (field.IsCollection)
                    {
                        @for (int i = 0; i < field.CollectionValues.Count; i++)
                        {
                            int idx = i;
                            <div class="minq-collection-row">
                                <input class="minq-input" type="text" @bind="field.CollectionValues[idx]" disabled="@field.Definition.ReadOnly" />
                                @if (!field.Definition.ReadOnly)
                                {
                                    <button class="minq-button minq-button-danger" @onclick="() => field.CollectionValues.RemoveAt(idx)">X</button>
                                }
                            </div>
                        }
                        @if (!field.Definition.ReadOnly)
                        {
                            <button class="minq-button" style="align-self: flex-start;" @onclick="() => field.CollectionValues.Add(string.Empty)">+ Add Entry</button>
                        }
                    }
                    else if (field.IsBool)
                    {
                        <div style="padding: 4px 0;">
                            @if (field.Definition.ReadOnly)
                            {
                                <input type="checkbox" checked="@field.BoolValue" disabled />
                            }
                            else
                            {
                                <label class="minq-switch">
                                    <input type="checkbox" @bind="field.BoolValue" />
                                    <span class="minq-slider-round"></span>
                                </label>
                            }
                        </div>
                    }
                    else if (field.IsEnum)
                    {
                        <select class="minq-input" @bind="field.SingleValue" disabled="@field.Definition.ReadOnly">
                            @foreach (string val in Enum.GetNames(field.TargetType))
                            {
                                <option value="@val">@val</option>
                            }
                        </select>
                    }
                    else if (field.IsChar)
                    {
                        <input class="minq-input" type="text" value="@field.SingleValue" @oninput="(e) => UpdateChar(field, e)" disabled="@field.Definition.ReadOnly" />
                    }
                    else if (field.IsNumeric)
                    {
                        <input class="minq-input" type="number" step="any" @bind="field.SingleValue" disabled="@field.Definition.ReadOnly" />
                    }
                    else
                    {
                        <input class="minq-input" type="text" @bind="field.SingleValue" disabled="@field.Definition.ReadOnly" />
                    }
                </div>
            }
        </div>
        
        <div class="minq-modal-footer" style="justify-content: space-between;">
            <div style="display: flex; gap: 0.5rem;">
                <button class="minq-button" @onclick="CopyJson">Copy JSON</button>
                <button class="minq-button" @onclick="CopyBson">Copy BSON</button>
            </div>
            <div style="display: flex; gap: 0.75rem;">
                <button class="minq-button" @onclick="Cancel">Cancel</button>
                <button class="minq-button minq-button-primary" @onclick="Apply">Update</button>
            </div>
        </div>
        
    </div>
</div>

@code {
    [Parameter] 
    public object Model { get; set; }
    
    [Parameter] 
    public IEnumerable<MinqColumnDefinition> ColumnDefinitions { get; set; } = new List<MinqColumnDefinition>();
    
    [Parameter] 
    public EventCallback<object> OnSave { get; set; }
    
    [Parameter] 
    public EventCallback OnCancel { get; set; }

    public List<FieldState> FieldStates { get; set; } = new List<FieldState>();
    private ElementReference ModalRef;

    protected override void OnInitialized()
    {
        List<MinqColumnDefinition> editableDefs = ColumnDefinitions.Distinct()
            .Where(d => !d.IsIgnored && !d.IsComplex)
            .ToList();

        editableDefs.Sort((a, b) =>
        {
            int minLen = Math.Min(a.OrderPath.Count, b.OrderPath.Count);
            for (int i = 0; i < minLen; i++)
            {
                if (a.OrderPath[i] != b.OrderPath[i])
                    return a.OrderPath[i].CompareTo(b.OrderPath[i]);
            }
            if (a.OrderPath.Count != b.OrderPath.Count)
                return a.OrderPath.Count.CompareTo(b.OrderPath.Count);
            return string.Compare(a.Name, b.Name, StringComparison.OrdinalIgnoreCase);
        });

        foreach (MinqColumnDefinition def in editableDefs)
        {
            Type targetType = Nullable.GetUnderlyingType(def.PropertyType) ?? def.PropertyType;
            FieldState state = new FieldState { Definition = def, TargetType = targetType };

            if (targetType == typeof(bool)) 
                state.IsBool = true;
            else if (targetType.IsEnum) 
                state.IsEnum = true;
            else if (targetType == typeof(char)) 
                state.IsChar = true;
            else if (IsNumericType(targetType)) 
                state.IsNumeric = true;
            else if (targetType != typeof(string) && typeof(System.Collections.IEnumerable).IsAssignableFrom(targetType))
            {
                state.IsCollection = true;
                state.ElementType = GetElementType(targetType);
            }

            object rawValue = ReadValue(def);

            if (state.IsCollection && rawValue is System.Collections.IEnumerable enumerable)
            {
                foreach (object item in enumerable)
                    state.CollectionValues.Add(item?.ToString() ?? string.Empty);
            }
            else if (state.IsBool)
                state.BoolValue = rawValue is bool b && b;
            else
                state.SingleValue = rawValue?.ToString() ?? string.Empty;

            FieldStates.Add(state);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ModalRef.FocusAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await Cancel();
    }

    public async Task CopyJson()
    {
        try
        {
            MethodInfo toJsonMethod = Model.GetType().GetMethod("ToJson");
            if (toJsonMethod != null)
            {
                string json = (string)toJsonMethod.Invoke(Model, null);
                await JSRuntime.CopyToClipboard(json);
            }
        }
        catch (Exception ex)
        {
            Log.Error($"Failed to copy JSON: {ex.Message}");
        }
    }

    public async Task CopyBson()
    {
        try
        {
            MethodInfo toBsonMethod = Model.GetType().GetMethod("ToBsonDocument");
            if (toBsonMethod != null)
            {
                object bsonDoc = toBsonMethod.Invoke(Model, null);
                string bsonStr = bsonDoc?.ToString() ?? string.Empty;
                await JSRuntime.CopyToClipboard(bsonStr);
            }
            else
            {
                Log.Warn("ToBsonDocument method not found on model instance. If it is a MongoDB extension method, it cannot be called directly via instance reflection without targeting the static BsonExtensionMethods class.");
            }
        }
        catch (Exception ex)
        {
            Log.Error($"Failed to copy BSON: {ex.Message}");
        }
    }

    private void UpdateChar(FieldState field, ChangeEventArgs e)
    {
        string val = e.Value?.ToString() ?? string.Empty;
        field.SingleValue = val.Length > 0 ? val.Substring(val.Length - 1) : string.Empty;
    }

    private object ReadValue(MinqColumnDefinition definition)
    {
        object current = Model;
        foreach (PropertyInfo prop in definition.PropertyPath)
        {
            if (current == null) return null;
            current = prop.GetValue(current);
        }
        return current;
    }

    public async Task Apply()
    {
        foreach (FieldState state in FieldStates)
        {
            if (state.Definition.ReadOnly) continue;

            object current = Model;
            
            for (int i = 0; i < state.Definition.PropertyPath.Length - 1; i++)
            {
                PropertyInfo prop = state.Definition.PropertyPath[i];
                object next = prop.GetValue(current);
                
                if (next == null)
                {
                    next = Activator.CreateInstance(prop.PropertyType);
                    prop.SetValue(current, next);
                }
                
                current = next;
            }

            PropertyInfo leafProp = state.Definition.PropertyPath.Last();
            object parsedVal = null;
            
            try
            {
                if (state.IsCollection)
                {
                    if (state.TargetType.IsArray)
                    {
                        Array arr = Array.CreateInstance(state.ElementType, state.CollectionValues.Count);
                        for (int i = 0; i < state.CollectionValues.Count; i++)
                        {
                            arr.SetValue(ParseValue(state.CollectionValues[i], state.ElementType), i);
                        }
                        parsedVal = arr;
                    }
                    else
                    {
                        Type listType = typeof(List<>).MakeGenericType(state.ElementType);
                        System.Collections.IList list = (System.Collections.IList)Activator.CreateInstance(listType);
                        foreach (string val in state.CollectionValues)
                        {
                            list.Add(ParseValue(val, state.ElementType));
                        }
                        parsedVal = list;
                    }
                }
                else if (state.IsBool)
                {
                    parsedVal = state.BoolValue;
                }
                else
                {
                    parsedVal = ParseValue(state.SingleValue, state.TargetType);
                }
            }
            catch
            {
                continue; 
            }

            if (parsedVal == null && state.TargetType.IsValueType && Nullable.GetUnderlyingType(leafProp.PropertyType) == null)
            {
                parsedVal = Activator.CreateInstance(state.TargetType);
            }

            leafProp.SetValue(current, parsedVal);
        }

        await OnSave.InvokeAsync(Model);
    }

    private object ParseValue(string strVal, Type targetType)
    {
        if (string.IsNullOrWhiteSpace(strVal)) return null;
        
        if (targetType == typeof(Guid)) return Guid.Parse(strVal);
        if (targetType.IsEnum) return Enum.Parse(targetType, strVal);
        if (targetType == typeof(DateTime) || targetType == typeof(DateTimeOffset)) return DateTime.Parse(strVal);
        if (targetType == typeof(char)) return strVal.Length > 0 ? strVal[0] : default(char);
        
        return Convert.ChangeType(strVal, targetType);
    }

    private bool IsNumericType(Type type)
    {
        return type == typeof(byte) || type == typeof(sbyte) ||
               type == typeof(short) || type == typeof(ushort) ||
               type == typeof(int) || type == typeof(uint) ||
               type == typeof(long) || type == typeof(ulong) ||
               type == typeof(float) || type == typeof(double) ||
               type == typeof(decimal);
    }

    private Type GetElementType(Type collectionType)
    {
        if (collectionType.IsArray) return collectionType.GetElementType();
        if (collectionType.IsGenericType) return collectionType.GetGenericArguments()[0];
        return typeof(object); 
    }

    public async Task Cancel() => await OnCancel.InvokeAsync();

    public class FieldState
    {
        public MinqColumnDefinition Definition { get; set; }
        public Type TargetType { get; set; }
        public bool IsCollection { get; set; }
        public Type ElementType { get; set; }
        public bool IsBool { get; set; }
        public bool IsEnum { get; set; }
        public bool IsChar { get; set; }
        public bool IsNumeric { get; set; }
        
        public string SingleValue { get; set; }
        public bool BoolValue { get; set; }
        public List<string> CollectionValues { get; set; } = new List<string>();
    }
}