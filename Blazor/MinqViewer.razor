@implements IDisposable
@using System.Linq
@using Microsoft.AspNetCore.Components.Web
@using Maynard.Minq.Blazor.Enums
@using Maynard.Minq.Blazor.Models
@using Microsoft.JSInterop
@inject IServiceProvider ServiceProvider
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<CascadingValue Value="this" IsFixed="true">
    <div class="minq-container" style="@ThemeVariables @(TabGroup != null && TabGroup.ActiveViewer != this ? "display: none;" : "")">
        @if (HasError)
        {
            <div class="empty-state">Error: @ErrorMessage</div>
        }
        else if (IsLoading)
        {
            <div class="empty-state">Loading data...</div>
        }
        else if (TotalRecords == 0)
        {
            <div class="empty-state">No data exists yet.</div>
        }
        else
        {
            <div class="minq-controls">
                <div style="display: flex; gap: 0.5rem;">
                    <button class="minq-button @(IsSettingsOpen ? "active" : "")" @onclick="ToggleSettings">
                        ⚙ Settings
                    </button>
                    <button class="minq-button" @onclick="CopyShareLink">
                        🔗 Copy Share Link
                    </button>
                </div>
                <div style="display: flex; align-items: center;">
                    <MinqTimer @ref="RefreshTimerComponent" Interval="State.RefreshInterval" OnRefreshTriggered="LoadData" />
                    
                    <button class="minq-button" @onclick="PreviousPage" disabled="@(PageNumber == 0)">&lt;</button>
                    <span class="minq-pagination-text"> @(PageNumber + 1) of @TotalPages </span>
                    <button class="minq-button" @onclick="NextPage" disabled="@(PageNumber + 1 >= TotalPages)">&gt;</button>
                </div>
            </div>

            @if (IsSettingsOpen)
            {
                <MinqViewerSettings 
                    Settings="State"
                    AvailableThemes="AvailableThemes.Select(t => t.Name)"
                    IsViewingSharedState="IsViewingSharedState"
                    CanDeleteSingle="CanDeleteSingle"
                    CanDeleteCollection="CanDeleteCollection"
                    OnSaveSharedAsDefault="SaveSharedAsDefault"
                    OnPageSizeChanged="OnPageSizeChanged"
                    OnRefreshIntervalChanged="OnRefreshIntervalChanged"
                    OnThemeChanged="OnThemeChangedAsync"
                    OnPreferencesChanged="SavePreferencesAsync"
                    OnViewDataChanged="OnViewDataChanged"
                    OnOpenColumnPicker="OpenColumnPicker"
                    OnOpenDeleteAllModal="OpenDeleteAllModal" />
            }

            <div class="minq-table-wrapper">
                <table class="minq-table" style="font-size: @(State.TableFontSize)px;">
                    <thead>
                        <tr>
                            @{ int headerOffset = 0; }
                            @foreach (string column in VisibleColumns)
                            {
                                bool isSticky = ColumnDefinitions.ContainsKey(column) && ColumnDefinitions[column].IsSticky;
                                string stickyStyle = isSticky ? $"position: sticky; left: {headerOffset}px; z-index: 2; width: {State.PinnedColumnWidth}px; min-width: {State.PinnedColumnWidth}px; max-width: {State.PinnedColumnWidth}px; overflow: hidden; text-overflow: ellipsis; border-right: 2px solid var(--minq-header-border);"
                                                              : $"max-width: {State.MaxColumnWidth}px; overflow: hidden; text-overflow: ellipsis;";
                                
                                if (isSticky) 
                                    headerOffset += State.PinnedColumnWidth;
                                <th style="@stickyStyle" title="@column">@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowIndex = 0; }
                        @foreach (Dictionary<string, string> row in Rows)
                        {
                            int currentIndex = rowIndex;
                            <tr class="@(State.RowClickBehavior != RowClickBehaviorOption.SelectText ? "minq-clickable-row" : "")" @onclick="() => HandleRowClick(currentIndex)">
                                @{ int cellOffset = 0; }
                                @foreach (string column in VisibleColumns)
                                {
                                    bool isSticky = ColumnDefinitions.ContainsKey(column) && ColumnDefinitions[column].IsSticky;
                                    string stickyStyle = isSticky ? $"position: sticky; left: {cellOffset}px; z-index: 1; width: {State.PinnedColumnWidth}px; min-width: {State.PinnedColumnWidth}px; max-width: {State.PinnedColumnWidth}px; overflow: hidden; text-overflow: ellipsis; background-color: inherit; border-right: 2px solid var(--minq-border);"
                                                                  : $"max-width: {State.MaxColumnWidth}px; overflow: hidden; text-overflow: ellipsis;";
                                    
                                    if (isSticky) 
                                        cellOffset += State.PinnedColumnWidth;
                                    string cellValue = row.ContainsKey(column) ? row[column] : string.Empty;
                                    ColumnDefinitions.TryGetValue(column, out MinqColumnDefinition cellDef);
                                    
                                    <td style="@stickyStyle" title="@cellValue">
                                        @if (cellDef != null && cellDef.IsTimestamp)
                                        {
                                            <MinqTimestampValue RawValue="@cellValue" Format="State.MinqViewerTimestampFormat" />
                                        }
                                        else if (cellDef != null && cellDef.IsBool && !string.IsNullOrWhiteSpace(cellValue))
                                        {
                                            bool isTrue = cellValue.Equals("True", StringComparison.OrdinalIgnoreCase);
                                            <span class="minq-badge @(isTrue ? "minq-badge-true" : "minq-badge-false")">@(isTrue ? "True" : "False")</span>
                                        }
                                        else
                                        {
                                            @cellValue
                                        }
                                    </td>
                                }
                            </tr>
                            rowIndex++;
                        }
                    </tbody>
                </table>
            </div>

            @if (IsColumnPickerOpen)
            {
                <ColumnPicker AvailableColumns="PickerColumns" HiddenColumns="HiddenColumns" OnApply="ApplyColumns" OnCancel="CloseColumnPicker" />
            }
            
            @if (IsEditorOpen && SelectedRecord != null)
            {
                <RecordEditor Model="SelectedRecord" ColumnDefinitions="ColumnDefinitions.Values" OnSave="SaveRecord" OnCancel="CloseModals" />
            }

            @if (IsDeleteModalOpen && SelectedRecord != null)
            {
                <DeleteRecord Model="SelectedRecord" IsCollection="false" OnDelete="DeleteRecord" OnCancel="CloseModals" />
            }

            @if (IsDeleteAllModalOpen)
            {
                <DeleteRecord IsCollection="true" OnDeleteCollection="DeleteAllRecords" OnCancel="CloseModals" />
            }
        }
    </div>
</CascadingValue>